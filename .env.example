# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# --- Hosted tenant ---
# Your tenant's slug.
REVENEXX_TENANT=your-tenant-slug
# An API key for that tenant (a development key with the * scope is simplest).
REVENEXX_API_KEY=your-api-key
# The API address; change it only if you were given a different one.
REVENEXX_BASE_URL=https://api.revenexx.com/v1

# --- Local stack: comment out the hosted block above and uncomment these ---
# REVENEXX_BASE_URL=http://localhost:8080/v1
# REVENEXX_TENANT=demo
# REVENEXX_TOKEN=your-token
