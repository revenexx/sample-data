{
  "name": "sample-data-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal UI for the sample-data seeder",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  }
}
